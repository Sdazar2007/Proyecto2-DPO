digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.75", fontname="DejaVu Sans", splines=polyline];
node [shape=plain,fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, color="#526478"];
ParticipanteTorneo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>ParticipanteTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String<BR ALIGN="LEFT"/>- nombre : String<BR ALIGN="LEFT"/>- usuarios : List&lt;Usuario&gt;<BR ALIGN="LEFT"/>- equipo : Equipo</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ jugadores(List&lt;Usuario&gt;) : ParticipanteTorneo<BR ALIGN="LEFT"/>+ equipo(Equipo) : ParticipanteTorneo<BR ALIGN="LEFT"/>+ contiene(Usuario) : boolean<BR ALIGN="LEFT"/>+ tieneEmpleado() : boolean</TD></TR></TABLE>>];
Usuario [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- login : String<BR ALIGN="LEFT"/>- activo : boolean<BR ALIGN="LEFT"/>- password : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Usuario$Builder</TD></TR></TABLE>>];
Socio [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Socio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- edad : int<BR ALIGN="LEFT"/>- puntos : int<BR ALIGN="LEFT"/>- inscripciones : List&lt;InscripcionEquipo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ newBuilder() : Socio$Builder</TD></TR></TABLE>>];
Empleado [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Empleado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigoDescuento : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nuevoBuilder() : Empleado$Builder</TD></TR></TABLE>>];
Estudiante [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Estudiante</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigoEstudiantil : String<BR ALIGN="LEFT"/>- matriculado : boolean</TD></TR></TABLE>>];
Externo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Externo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String<BR ALIGN="LEFT"/>- documento : String</TD></TR></TABLE>>];
Equipo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Equipo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String<BR ALIGN="LEFT"/>- activo : boolean<BR ALIGN="LEFT"/>- cupoMaximo : int<BR ALIGN="LEFT"/>- deporte : Deporte<BR ALIGN="LEFT"/>- categoria : Categoria<BR ALIGN="LEFT"/>- inscripciones : List&lt;InscripcionEquipo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Equipo$Builder</TD></TR></TABLE>>];
TorneoRecreativo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>TorneoRecreativo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- porcentajeDescuento : double<BR ALIGN="LEFT"/>- bonos : List&lt;BonoDescuento&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ tarifa(ParticipanteTorneo) : double<BR ALIGN="LEFT"/>~ otorgar(ParticipanteTorneo) : void</TD></TR></TABLE>>];
TorneoCompetitivo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>TorneoCompetitivo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tarifaInscripcion : double<BR ALIGN="LEFT"/>- premios : List&lt;PremioEfectivo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ tarifa(ParticipanteTorneo) : double<BR ALIGN="LEFT"/>+ calcularRecaudacion() : double<BR ALIGN="LEFT"/>+ calcularPremio() : double<BR ALIGN="LEFT"/>~ otorgar(ParticipanteTorneo) : void</TD></TR></TABLE>>];
BonoDescuento [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>BonoDescuento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigo : String<BR ALIGN="LEFT"/>- propietario : Usuario<BR ALIGN="LEFT"/>- porcentaje : double<BR ALIGN="LEFT"/>- utilizado : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ estaDisponible() : boolean<BR ALIGN="LEFT"/>~ redimir() : void</TD></TR></TABLE>>];
PremioEfectivo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>PremioEfectivo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- participante : ParticipanteTorneo<BR ALIGN="LEFT"/>- monto : double<BR ALIGN="LEFT"/>- entregado : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ marcarEntregado() : void</TD></TR></TABLE>>];
ParticipanteTorneo -> Usuario [arrowhead=none,label="usuarios"];
ParticipanteTorneo -> Equipo [arrowhead=none,label="equipo"];
Socio -> Usuario [arrowhead=empty,label=""];
Empleado -> Usuario [arrowhead=empty,label=""];
Estudiante -> Usuario [arrowhead=empty,label=""];
Externo -> Usuario [arrowhead=empty,label=""];
TorneoRecreativo -> BonoDescuento [dir=both, arrowtail=diamond, arrowhead=none,label="bonos"];
TorneoCompetitivo -> PremioEfectivo [dir=both, arrowtail=diamond, arrowhead=none,label="premios"];
BonoDescuento -> Usuario [arrowhead=none,label="propietario"];
PremioEfectivo -> ParticipanteTorneo [arrowhead=none,label="participante"];
}