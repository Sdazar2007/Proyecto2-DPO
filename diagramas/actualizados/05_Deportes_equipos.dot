digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.75", fontname="DejaVu Sans", splines=polyline];
node [shape=plain,fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, color="#526478"];
ServicioDeportivo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>ServicioDeportivo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- equipos : List&lt;Equipo&gt;<BR ALIGN="LEFT"/>- partidos : List&lt;Partido&gt;<BR ALIGN="LEFT"/>- inscripcionesCompetencia : List&lt;InscripcionCompetencia&gt;<BR ALIGN="LEFT"/>- nominas : List&lt;NominaCompetencia&gt;<BR ALIGN="LEFT"/>- estadisticas : List&lt;EstadisticaJugador&gt;<BR ALIGN="LEFT"/>- suspensiones : Map&lt;Socio, Integer&gt;<BR ALIGN="LEFT"/>- amarillasAcumuladas : Map&lt;Socio, Integer&gt;<BR ALIGN="LEFT"/>- alineaciones : Map&lt;Partido, List&lt;Socio&gt;&gt;<BR ALIGN="LEFT"/>- resultados : Map&lt;Partido, int[]&gt;<BR ALIGN="LEFT"/>- deportesCompetencia : Map&lt;Competencia, Deporte&gt;<BR ALIGN="LEFT"/>- categoriasCompetencia : Map&lt;Competencia, Categoria&gt;<BR ALIGN="LEFT"/>- puntosCompetencia : Map&lt;Competencia, Map&lt;Equipo, Integer&gt;&gt;<BR ALIGN="LEFT"/>- participantesPartido : Map&lt;Partido, Set&lt;Socio&gt;&gt;<BR ALIGN="LEFT"/>- estadisticasTabla : Map&lt;Competencia, Map&lt;Equipo, int[]&gt;&gt;<BR ALIGN="LEFT"/>- fases : Map&lt;PartidoCompetencia, String&gt;<BR ALIGN="LEFT"/>- grupos : Map&lt;PartidoCompetencia, String&gt;<BR ALIGN="LEFT"/>- eliminados : Map&lt;Competencia, Set&lt;Equipo&gt;&gt;<BR ALIGN="LEFT"/>- amarillasTorneo : Map&lt;Competencia, Map&lt;Socio, Integer&gt;&gt;<BR ALIGN="LEFT"/>- suspensionesTorneo : Map&lt;Competencia, Map&lt;Socio, Integer&gt;&gt;<BR ALIGN="LEFT"/>- encuentrosExternos : Map&lt;Competencia, List&lt;ServicioDeportivo$EncuentroExterno&gt;&gt;<BR ALIGN="LEFT"/>- gruposInstitucion : Map&lt;Competencia, Map&lt;String, String&gt;&gt;<BR ALIGN="LEFT"/>- umbralesAmarillas : Map&lt;Competencia, Map&lt;String, Integer&gt;&gt;<BR ALIGN="LEFT"/>- eliminadosExternos : Map&lt;Competencia, Set&lt;String&gt;&gt;<BR ALIGN="LEFT"/>- clasificados : Map&lt;Competencia, List&lt;String&gt;&gt;<BR ALIGN="LEFT"/>- cruces : Map&lt;Competencia, Map&lt;String, String&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombreValido(String) : String<BR ALIGN="LEFT"/>- puntosVictoria(Deporte) : int<BR ALIGN="LEFT"/>- sumar(ServicioDeportivo$FilaTabla, ServicioDeportivo$FilaTabla, int, int, Deporte) : void<BR ALIGN="LEFT"/>+ registrarEncuentroExterno(Competencia, String, String, int, int, String, String) : ServicioDeportivo$EncuentroExterno<BR ALIGN="LEFT"/>+ tablaCompleta(Competencia, String, String) : List&lt;ServicioDeportivo$FilaTabla&gt;<BR ALIGN="LEFT"/>+ tablaConDesempateDirecto(Competencia, String, String) : List&lt;ServicioDeportivo$FilaTabla&gt;<BR ALIGN="LEFT"/>- resultadoDirecto(Competencia, String, String, String, String) : int<BR ALIGN="LEFT"/>+ clasificarPorGrupos(Competencia, int) : List&lt;String&gt;</TD></TR></TABLE>>];
Equipo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Equipo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String<BR ALIGN="LEFT"/>- activo : boolean<BR ALIGN="LEFT"/>- cupoMaximo : int<BR ALIGN="LEFT"/>- deporte : Deporte<BR ALIGN="LEFT"/>- categoria : Categoria<BR ALIGN="LEFT"/>- inscripciones : List&lt;InscripcionEquipo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Equipo$Builder</TD></TR></TABLE>>];
InscripcionEquipo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>InscripcionEquipo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- posicion : String<BR ALIGN="LEFT"/>- numeroCamiseta : int<BR ALIGN="LEFT"/>- socio : Socio<BR ALIGN="LEFT"/>- equipo : Equipo</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : InscripcionEquipo$Builder</TD></TR></TABLE>>];
Socio [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Socio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- edad : int<BR ALIGN="LEFT"/>- puntos : int<BR ALIGN="LEFT"/>- inscripciones : List&lt;InscripcionEquipo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ newBuilder() : Socio$Builder</TD></TR></TABLE>>];
Deporte [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Deporte</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Deporte$Builder</TD></TR></TABLE>>];
Categoria [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Categoria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Categoria$Builder</TD></TR></TABLE>>];
Partido [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Partido</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fecha : Date<BR ALIGN="LEFT"/>- marcador : String<BR ALIGN="LEFT"/>- escenario : Escenario</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Partido$Builder</TD></TR></TABLE>>];
PartidoInterno [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>PartidoInterno</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- equipoLocal : Equipo<BR ALIGN="LEFT"/>- equipoVisitante : Equipo</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ newBuilder() : PartidoInterno$Builder</TD></TR></TABLE>>];
Escenario [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Escenario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Escenario$Builder</TD></TR></TABLE>>];
ServicioDeportivo -> Equipo [arrowhead=none,label="equipos, puntosCompetencia, estadisticasTabla, eliminados"];
ServicioDeportivo -> Partido [arrowhead=none,label="partidos, alineaciones, resultados, participantesPartido"];
ServicioDeportivo -> Socio [arrowhead=none,label="suspensiones, amarillasAcumuladas, alineaciones, participantesPartido, amarillasTorneo, suspensionesTorneo"];
ServicioDeportivo -> Deporte [arrowhead=none,label="deportesCompetencia"];
ServicioDeportivo -> Categoria [arrowhead=none,label="categoriasCompetencia"];
Equipo -> Deporte [arrowhead=none,label="deporte"];
Equipo -> Categoria [arrowhead=none,label="categoria"];
Equipo -> InscripcionEquipo [arrowhead=none,label="inscripciones"];
InscripcionEquipo -> Socio [arrowhead=none,label="socio"];
InscripcionEquipo -> Equipo [arrowhead=none,label="equipo"];
Socio -> InscripcionEquipo [arrowhead=none,label="inscripciones"];
Partido -> Escenario [arrowhead=none,label="escenario"];
PartidoInterno -> Partido [arrowhead=empty,label=""];
PartidoInterno -> Equipo [arrowhead=none,label="equipoLocal, equipoVisitante"];
}