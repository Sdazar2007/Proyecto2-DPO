digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.75", fontname="DejaVu Sans", splines=polyline];
node [shape=plain,fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, color="#526478"];
EstadisticaJugador [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>EstadisticaJugador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- socio : Socio<BR ALIGN="LEFT"/>- partido : Partido</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : EstadisticaJugador$Builder</TD></TR></TABLE>>];
EstadisticaFutbol [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>EstadisticaFutbol</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- goles : int<BR ALIGN="LEFT"/>- asistencias : int<BR ALIGN="LEFT"/>- amarillas : int<BR ALIGN="LEFT"/>- rojas : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ newBuilder() : EstadisticaFutbol$Builder</TD></TR></TABLE>>];
EstadisticaBaloncesto [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>EstadisticaBaloncesto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- puntos : int<BR ALIGN="LEFT"/>- rebotes : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ newBuilder() : EstadisticaBaloncesto$Builder</TD></TR></TABLE>>];
EstadisticaVoleibol [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>EstadisticaVoleibol</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- aces : int<BR ALIGN="LEFT"/>- bloqueos : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ newBuilder() : EstadisticaVoleibol$Builder</TD></TR></TABLE>>];
EstadisticaTenisPadel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>EstadisticaTenisPadel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- setsGanados : int<BR ALIGN="LEFT"/>- gamesGanados : int<BR ALIGN="LEFT"/>- aces : int<BR ALIGN="LEFT"/>- erroresNoForzados : int<BR ALIGN="LEFT"/>- socio : Socio<BR ALIGN="LEFT"/>- partido : PartidoPractica</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : EstadisticaTenisPadel$Builder</TD></TR></TABLE>>];
EstadisticaTenisMesa [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>EstadisticaTenisMesa</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- setsGanados : int<BR ALIGN="LEFT"/>- puntosTotales : int<BR ALIGN="LEFT"/>- socio : Socio<BR ALIGN="LEFT"/>- partido : PartidoPractica</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : EstadisticaTenisMesa$Builder</TD></TR></TABLE>>];
Socio [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Socio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- edad : int<BR ALIGN="LEFT"/>- puntos : int<BR ALIGN="LEFT"/>- inscripciones : List&lt;InscripcionEquipo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ newBuilder() : Socio$Builder</TD></TR></TABLE>>];
Partido [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Partido</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fecha : Date<BR ALIGN="LEFT"/>- marcador : String<BR ALIGN="LEFT"/>- escenario : Escenario</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Partido$Builder</TD></TR></TABLE>>];
EstadisticaJugador -> Socio [arrowhead=none,label="socio"];
EstadisticaJugador -> Partido [arrowhead=none,label="partido"];
EstadisticaFutbol -> EstadisticaJugador [arrowhead=empty,label=""];
EstadisticaBaloncesto -> EstadisticaJugador [arrowhead=empty,label=""];
EstadisticaVoleibol -> EstadisticaJugador [arrowhead=empty,label=""];
EstadisticaTenisPadel -> Socio [arrowhead=none,label="socio"];
EstadisticaTenisMesa -> Socio [arrowhead=none,label="socio"];
}