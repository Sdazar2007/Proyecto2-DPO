digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.75", fontname="DejaVu Sans", splines=polyline];
node [shape=plain,fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, color="#526478"];
ServicioComercial [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>ServicioComercial</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- catalogo : List&lt;Producto&gt;<BR ALIGN="LEFT"/>- ventas : List&lt;Venta&gt;<BR ALIGN="LEFT"/>- existencias : Map&lt;ArticuloTienda, Map&lt;String, Integer&gt;&gt;<BR ALIGN="LEFT"/>- reabastecimientos : List&lt;Reabastecimiento&gt;<BR ALIGN="LEFT"/>- portadoresBebidaCaliente : Set&lt;Socio&gt;<BR ALIGN="LEFT"/>- avisosAlergenos : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- exigir(boolean, String) : void<BR ALIGN="LEFT"/>- dinero(double) : BigDecimal<BR ALIGN="LEFT"/>- redondear(BigDecimal) : BigDecimal<BR ALIGN="LEFT"/>- nombre(String) : String<BR ALIGN="LEFT"/>+ registrarProducto(Producto) : void<BR ALIGN="LEFT"/>+ stock(ArticuloTienda, String) : int<BR ALIGN="LEFT"/>+ reabastecer(ArticuloTienda, int, String) : void<BR ALIGN="LEFT"/>+ mover(ArticuloTienda, String, String, int) : void</TD></TR></TABLE>>];
Producto [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Producto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String<BR ALIGN="LEFT"/>- precio : double<BR ALIGN="LEFT"/>- activo : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Producto$Builder</TD></TR></TABLE>>];
ArticuloTienda [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>ArticuloTienda</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- categoria : String<BR ALIGN="LEFT"/>- cantidad : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nuevoBuilder() : ArticuloTienda$Builder</TD></TR></TABLE>>];
Bebida [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Bebida</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- esCaliente : boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nuevoBuilder() : Bebida$Builder</TD></TR></TABLE>>];
Snack [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Snack</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- alergenos : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nuevoBuilder() : Snack$Builder</TD></TR></TABLE>>];
Venta [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Venta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fecha : Date<BR ALIGN="LEFT"/>- subtotal : double<BR ALIGN="LEFT"/>- descuento : double<BR ALIGN="LEFT"/>- impuesto : double<BR ALIGN="LEFT"/>- total : double<BR ALIGN="LEFT"/>- propina : double<BR ALIGN="LEFT"/>- rubro : String<BR ALIGN="LEFT"/>- comprador : Usuario<BR ALIGN="LEFT"/>- items : List&lt;ItemVenta&gt;<BR ALIGN="LEFT"/>- puntosRedimidos : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Venta$Builder</TD></TR></TABLE>>];
ItemVenta [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>ItemVenta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- cantidad : int<BR ALIGN="LEFT"/>- producto : Producto<BR ALIGN="LEFT"/>- precioUnitario : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : ItemVenta$Builder</TD></TR></TABLE>>];
Reabastecimiento [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Reabastecimiento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fecha : Date<BR ALIGN="LEFT"/>- cantidad : int<BR ALIGN="LEFT"/>- articulo : ArticuloTienda<BR ALIGN="LEFT"/>- ubicacion : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Reabastecimiento$Builder</TD></TR></TABLE>>];
ReporteVentas [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>ReporteVentas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- periodo : String<BR ALIGN="LEFT"/>- total : double<BR ALIGN="LEFT"/>- rubro : String<BR ALIGN="LEFT"/>- desde : Date<BR ALIGN="LEFT"/>- hasta : Date</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : ReporteVentas$Builder</TD></TR></TABLE>>];
Usuario [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- login : String<BR ALIGN="LEFT"/>- activo : boolean<BR ALIGN="LEFT"/>- password : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Usuario$Builder</TD></TR></TABLE>>];
Empleado [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Empleado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigoDescuento : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nuevoBuilder() : Empleado$Builder</TD></TR></TABLE>>];
ServicioComercial -> Producto [arrowhead=none,label="catalogo"];
ServicioComercial -> Venta [arrowhead=none,label="ventas"];
ServicioComercial -> ArticuloTienda [arrowhead=none,label="existencias"];
ServicioComercial -> Reabastecimiento [arrowhead=none,label="reabastecimientos"];
ArticuloTienda -> Producto [arrowhead=empty,label=""];
Bebida -> Producto [arrowhead=empty,label=""];
Snack -> Producto [arrowhead=empty,label=""];
Venta -> Usuario [arrowhead=none,label="comprador"];
Venta -> ItemVenta [arrowhead=none,label="items"];
ItemVenta -> Producto [arrowhead=none,label="producto"];
Reabastecimiento -> ArticuloTienda [arrowhead=none,label="articulo"];
Empleado -> Usuario [arrowhead=empty,label=""];
}