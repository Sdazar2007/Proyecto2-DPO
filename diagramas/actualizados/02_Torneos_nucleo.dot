digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.75", fontname="DejaVu Sans", splines=polyline];
node [shape=plain,fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, color="#526478"];
ServicioTorneos [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>ServicioTorneos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- torneos : List&lt;Torneo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ crearTorneo(Torneo) : void<BR ALIGN="LEFT"/>+ buscarTorneo(String) : Torneo<BR ALIGN="LEFT"/>+ consultarTorneos() : List&lt;Torneo&gt;<BR ALIGN="LEFT"/>+ consultarHistorial(String) : Torneo<BR ALIGN="LEFT"/>+ consultarBonos(Usuario) : List&lt;BonoDescuento&gt;<BR ALIGN="LEFT"/>~ buscarBono(Usuario, String) : BonoDescuento</TD></TR></TABLE>>];
Torneo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B><I>Torneo</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String<BR ALIGN="LEFT"/>- nombre : String<BR ALIGN="LEFT"/>- fecha : LocalDate<BR ALIGN="LEFT"/>- cupoMaximo : int<BR ALIGN="LEFT"/>- deporte : Deporte<BR ALIGN="LEFT"/>- categoria : Categoria<BR ALIGN="LEFT"/>- modalidad : ModalidadTorneo<BR ALIGN="LEFT"/>- estado : EstadoTorneo<BR ALIGN="LEFT"/>- cuposPreferencialesLiberados : boolean<BR ALIGN="LEFT"/>- inscripciones : List&lt;InscripcionTorneo&gt;<BR ALIGN="LEFT"/>- encuentros : List&lt;EncuentroTorneo&gt;<BR ALIGN="LEFT"/>- ranking : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ exigir(boolean, String) : void<BR ALIGN="LEFT"/>+ calcularCuposPreferenciales() : int<BR ALIGN="LEFT"/>+ calcularCuposDisponibles() : int<BR ALIGN="LEFT"/>+ cuposRegularesDisponibles() : int<BR ALIGN="LEFT"/>~ activas() : List&lt;InscripcionTorneo&gt;<BR ALIGN="LEFT"/>~ configurarRanking(List&lt;String&gt;) : void<BR ALIGN="LEFT"/>~ inscribir(ParticipanteTorneo) : InscripcionTorneo<BR ALIGN="LEFT"/>~ desinscribir(String) : void<BR ALIGN="LEFT"/>~ liberarCuposPreferenciales() : void<BR ALIGN="LEFT"/>~ iniciarTorneo() : void<BR ALIGN="LEFT"/>~ registrarResultado(String, int, int) : void<BR ALIGN="LEFT"/>+ victorias(ParticipanteTorneo) : int<BR ALIGN="LEFT"/>+ diferencia(ParticipanteTorneo) : int<BR ALIGN="LEFT"/>+ consultarPosiciones() : List&lt;InscripcionTorneo&gt;<BR ALIGN="LEFT"/>~ finalizarTorneo() : void<BR ALIGN="LEFT"/>~ tarifa(ParticipanteTorneo) : double<BR ALIGN="LEFT"/>~ otorgar(ParticipanteTorneo) : void</TD></TR></TABLE>>];
TorneoCompetitivo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>TorneoCompetitivo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tarifaInscripcion : double<BR ALIGN="LEFT"/>- premios : List&lt;PremioEfectivo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ tarifa(ParticipanteTorneo) : double<BR ALIGN="LEFT"/>+ calcularRecaudacion() : double<BR ALIGN="LEFT"/>+ calcularPremio() : double<BR ALIGN="LEFT"/>~ otorgar(ParticipanteTorneo) : void</TD></TR></TABLE>>];
TorneoRecreativo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>TorneoRecreativo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- porcentajeDescuento : double<BR ALIGN="LEFT"/>- bonos : List&lt;BonoDescuento&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ tarifa(ParticipanteTorneo) : double<BR ALIGN="LEFT"/>~ otorgar(ParticipanteTorneo) : void</TD></TR></TABLE>>];
InscripcionTorneo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>InscripcionTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- participante : ParticipanteTorneo<BR ALIGN="LEFT"/>- fechaInscripcion : LocalDate<BR ALIGN="LEFT"/>- preferencial : boolean<BR ALIGN="LEFT"/>- valorInscripcion : double<BR ALIGN="LEFT"/>- activa : boolean<BR ALIGN="LEFT"/>- posicionFinal : Integer</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ cancelar() : void<BR ALIGN="LEFT"/>~ asignarPosicion(int) : void</TD></TR></TABLE>>];
EncuentroTorneo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>EncuentroTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String<BR ALIGN="LEFT"/>- fecha : LocalDate<BR ALIGN="LEFT"/>- local : ParticipanteTorneo<BR ALIGN="LEFT"/>- visitante : ParticipanteTorneo<BR ALIGN="LEFT"/>- puntosLocal : Integer<BR ALIGN="LEFT"/>- puntosVisitante : Integer</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ registrarResultado(int, int) : void<BR ALIGN="LEFT"/>+ consultarGanador() : ParticipanteTorneo<BR ALIGN="LEFT"/>+ diferencia(ParticipanteTorneo) : int</TD></TR></TABLE>>];
ParticipanteTorneo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>ParticipanteTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String<BR ALIGN="LEFT"/>- nombre : String<BR ALIGN="LEFT"/>- usuarios : List&lt;Usuario&gt;<BR ALIGN="LEFT"/>- equipo : Equipo</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ jugadores(List&lt;Usuario&gt;) : ParticipanteTorneo<BR ALIGN="LEFT"/>+ equipo(Equipo) : ParticipanteTorneo<BR ALIGN="LEFT"/>+ contiene(Usuario) : boolean<BR ALIGN="LEFT"/>+ tieneEmpleado() : boolean</TD></TR></TABLE>>];
EstadoTorneo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>«enumeration»<BR/>EstadoTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ABIERTO<BR ALIGN="LEFT"/>EN_CURSO<BR ALIGN="LEFT"/>FINALIZADO</TD></TR></TABLE>>];
ModalidadTorneo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>«enumeration»<BR/>ModalidadTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">INDIVIDUAL<BR ALIGN="LEFT"/>DOBLES<BR ALIGN="LEFT"/>EQUIPOS</TD></TR></TABLE>>];
Deporte [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Deporte</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Deporte$Builder</TD></TR></TABLE>>];
Categoria [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Categoria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Categoria$Builder</TD></TR></TABLE>>];
ServicioTorneos -> Torneo [dir=both, arrowtail=diamond, arrowhead=none,label="torneos"];
Torneo -> Deporte [arrowhead=none,label="deporte"];
Torneo -> Categoria [arrowhead=none,label="categoria"];
Torneo -> ModalidadTorneo [arrowhead=none,label="modalidad"];
Torneo -> EstadoTorneo [arrowhead=none,label="estado"];
Torneo -> InscripcionTorneo [dir=both, arrowtail=diamond, arrowhead=none,label="inscripciones"];
Torneo -> EncuentroTorneo [dir=both, arrowtail=diamond, arrowhead=none,label="encuentros"];
TorneoCompetitivo -> Torneo [arrowhead=empty,label=""];
TorneoRecreativo -> Torneo [arrowhead=empty,label=""];
InscripcionTorneo -> ParticipanteTorneo [arrowhead=none,label="participante"];
EncuentroTorneo -> ParticipanteTorneo [arrowhead=none,label="local, visitante"];
}