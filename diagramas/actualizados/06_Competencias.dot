digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="0.75", fontname="DejaVu Sans", splines=polyline];
node [shape=plain,fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, color="#526478"];
Competencia [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Competencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String<BR ALIGN="LEFT"/>- entidadOrganizadora : String<BR ALIGN="LEFT"/>- anioTemporada : int<BR ALIGN="LEFT"/>- formato : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Competencia$Builder</TD></TR></TABLE>>];
InscripcionCompetencia [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>InscripcionCompetencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- equipo : Equipo<BR ALIGN="LEFT"/>- competencia : Competencia</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : InscripcionCompetencia$Builder</TD></TR></TABLE>>];
NominaCompetencia [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>NominaCompetencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- inscripcion : InscripcionCompetencia<BR ALIGN="LEFT"/>- jugadores : List&lt;Socio&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : NominaCompetencia$Builder</TD></TR></TABLE>>];
Equipo [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Equipo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String<BR ALIGN="LEFT"/>- activo : boolean<BR ALIGN="LEFT"/>- cupoMaximo : int<BR ALIGN="LEFT"/>- deporte : Deporte<BR ALIGN="LEFT"/>- categoria : Categoria<BR ALIGN="LEFT"/>- inscripciones : List&lt;InscripcionEquipo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Equipo$Builder</TD></TR></TABLE>>];
Partido [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Partido</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- fecha : Date<BR ALIGN="LEFT"/>- marcador : String<BR ALIGN="LEFT"/>- escenario : Escenario</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : Partido$Builder</TD></TR></TABLE>>];
PartidoCompetencia [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>PartidoCompetencia</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- competencia : Competencia<BR ALIGN="LEFT"/>- equipo : Equipo<BR ALIGN="LEFT"/>- rival : InstitucionRival</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ newBuilder() : PartidoCompetencia$Builder</TD></TR></TABLE>>];
InstitucionRival [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>InstitucionRival</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombre : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ builder() : InstitucionRival$Builder</TD></TR></TABLE>>];
Socio [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#64748B"><TR><TD BGCOLOR="#E5EEF7"><B>Socio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- edad : int<BR ALIGN="LEFT"/>- puntos : int<BR ALIGN="LEFT"/>- inscripciones : List&lt;InscripcionEquipo&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ newBuilder() : Socio$Builder</TD></TR></TABLE>>];
InscripcionCompetencia -> Equipo [arrowhead=none,label="equipo"];
InscripcionCompetencia -> Competencia [arrowhead=none,label="competencia"];
NominaCompetencia -> InscripcionCompetencia [arrowhead=none,label="inscripcion"];
NominaCompetencia -> Socio [arrowhead=none,label="jugadores"];
PartidoCompetencia -> Partido [arrowhead=empty,label=""];
PartidoCompetencia -> Competencia [arrowhead=none,label="competencia"];
PartidoCompetencia -> Equipo [arrowhead=none,label="equipo"];
PartidoCompetencia -> InstitucionRival [arrowhead=none,label="rival"];
}